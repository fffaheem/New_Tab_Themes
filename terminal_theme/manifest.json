{
  "manifest_version": 3,
  "name": "Terminal New Tab",
  "version": "1",
  "description": "Terminal Based new tab for coders",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "bookmarks"
  ]
}